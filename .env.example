# ETH Weekend — ORB M5 su ETHUSD. Solo MetaApi per i prezzi.

DATABASE_URL=
CRON_SECRET=

METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=
# Nome esatto del simbolo sul tuo MT5 (es. ETHUSD, ETHUSD., ETHUSDm)
METAAPI_SYMBOL=ETHUSD

# true = l'app analizza solo da venerdi 21:00 UTC a domenica 22:00 UTC (quando l'oro e' chiuso)
SOLO_WEEKEND=true

# Buffer spread in % del prezzo (0.05 = 0.05%). Usato solo sul controllo SL:
# BUY: SL toccato se low <= SL + buffer; SELL: SL toccato se high >= SL - buffer.
# Compensa candele Bid MetaApi (Ask implicito sui SELL, stop più facile sui BUY).
SPREAD_BUFFER_PCT=0.05

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
